# =====================================================================
# AUTOSAR Architecture Intelligence Assistant Environment Configuration
# =====================================================================

# Database Settings (use the Compose value or replace with local PostgreSQL)
DATABASE_URL=postgresql://autosar:development-only-change-me@postgres:5432/autosar_assistant
EMBEDDING_DIMENSIONS=768

# ---------------------------------------------------------------------
# LLM Settings — Groq OpenAI-compatible API (development demo)
# ---------------------------------------------------------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=120.0
GROQ_API_KEY=

# Local Ollama alternative (uncomment and use a validated local model):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL=<validated-local-chat-model>

# ---------------------------------------------------------------------
# Embedding Settings — Gemini native API (development demo)
# ---------------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_MODEL_VERSION=v1
GEMINI_API_KEY=

# Local Ollama alternative. Set the real vector dimension and re-embed after changing it:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://host.docker.internal:11434
# EMBEDDING_MODEL=<validated-local-embedding-model>
# EMBEDDING_DIMENSIONS=<actual-model-dimension>

# ---------------------------------------------------------------------
# Security & Operational Settings
# ---------------------------------------------------------------------
AUTH_MODE=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# OCR (scanned pages). none | tesseract (local) | gemini (EXTERNAL: needs consent flag below)
# ---------------------------------------------------------------------
OCR_PROVIDER=none
OCR_ALLOW_EXTERNAL=false

# ---------------------------------------------------------------------
# Retrieval, entity resolution and sources (defaults shown)
# ---------------------------------------------------------------------
# RAG_DEFAULT_TOP_K=8
# RAG_MAX_ROUNDS=2
# RESOLUTION_LLM_ENABLED=true
# RESOLUTION_LLM_MIN_CONFIDENCE=0.85
# RESOLUTION_MAX_LLM_PAIRS=200
# REQUIRE_APPROVED_SOURCES=false
# APPROVED_SOURCE_STATUSES=["approved","released","baselined"]
